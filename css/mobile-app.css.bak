/* =====================================================
   Medigo Website Layout — Group A (Khách hàng & Seller)
   Full-width responsive website: 1200px max-width content
   ===================================================== */

/* ===== WRAPPER: Full-width, no box shadow ===== */
.web-wrapper {
  width: 100%;
  min-height: 100vh;
  background-color: #FFFFFF;
  display: flex;
  flex-direction: column;
}

/* ===== AFF NOTICE BAR: Full-width top strip ===== */
.aff-notice-bar {
  background-color: var(--c11);
  color: var(--c1);
  padding: 10px 40px;
  font-size: 15px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
}

/* ===== HEADER: Full-width sticky nav ===== */
.app-header {
  height: 72px;
  padding: 0 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #E5E7EB;
  background-color: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 100;
  width: 100%;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
}

.logo-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 22px;
  font-weight: 800;
  color: var(--c6);
  cursor: pointer;
  text-decoration: none;
  letter-spacing: -0.5px;
}

.logo-brand:hover { text-decoration: none; }

/* Nav links — hidden on mobile, shown on ≥768px */
.web-nav-links {
  display: none;
  align-items: center;
  gap: 36px;
  list-style: none;
  margin: 0;
  padding: 0;
}

@media (min-width: 768px) {
  .web-nav-links { display: flex; }
}

.web-nav-links a {
  color: var(--c1);
  font-weight: 600;
  font-size: 15px;
  transition: color 0.15s;
  padding: 6px 0;
  border-bottom: 2px solid transparent;
}

.web-nav-links a:hover {
  color: var(--c6);
  text-decoration: none;
  border-bottom-color: var(--c6);
}

.web-nav-links a.active-nav {
  color: var(--c6);
  border-bottom-color: var(--c6);
}

.cart-icon-btn {
  position: relative;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #F3F4F6;
  color: var(--c1);
  border: none;
  cursor: pointer;
  transition: background 0.15s;
}

.cart-icon-btn:hover { background-color: #E5E7EB; }

.cart-badge-count {
  position: absolute;
  top: 0;
  right: 0;
  background-color: var(--err);
  color: #FFF;
  font-size: 11px;
  font-weight: 800;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== CONTENT CONTAINER: max-width 1200px, centered ===== */
.page-content {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ===== PRODUCT HERO: 2-col on desktop ===== */
.product-hero-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 48px;
  padding: 48px 40px;
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

@media (min-width: 900px) {
  .product-hero-grid {
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }
}

/* ===== IMAGE CAROUSEL ===== */
.product-carousel {
  position: relative;
  width: 100%;
  height: 360px;
  background-color: #F8F9FA;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0,0,0,0.08);
}

@media (min-width: 900px) {
  .product-carousel { height: 460px; }
}

.product-carousel img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.carousel-dots {
  position: absolute;
  bottom: 16px;
  left: 0; right: 0;
  display: flex;
  justify-content: center;
  gap: 8px;
}

.carousel-dot {
  width: 10px; height: 10px;
  border-radius: 50%;
  background-color: rgba(255,255,255,0.6);
  cursor: pointer;
  transition: all 0.2s;
}

.carousel-dot.active {
  width: 28px;
  border-radius: 5px;
  background-color: var(--c6);
}

/* ===== PRODUCT INFO PANEL ===== */
.product-title {
  font-size: 26px;
  font-weight: 800;
  color: var(--c1);
  margin-bottom: 12px;
  line-height: 1.3;
}

.product-price-tag {
  font-size: 36px;
  font-weight: 800;
  color: var(--err);
  margin-bottom: 20px;
}

.product-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

/* ===== QUANTITY CONTROL ===== */
.quantity-control {
  display: flex;
  align-items: center;
  border: 1px solid var(--c7);
  border-radius: 8px;
  overflow: hidden;
}

.qty-btn {
  width: 44px;
  height: 44px;
  background-color: #F5F7FA;
  border: none;
  font-size: 20px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s;
}

.qty-btn:hover { background-color: #E8EDF2; }

.qty-input {
  width: 56px;
  height: 44px;
  border: none;
  text-align: center;
  font-size: 18px;
  font-weight: 700;
  color: var(--c1);
}

/* ===== SECTION SEPARATOR ===== */
.section-block {
  padding: 48px 40px;
  border-top: 1px solid #E5E7EB;
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

.section-card {
  padding: 24px;
  border-bottom: 1px solid #E5E7EB;
}

/* ===== FEATURES GRID: 2-col on desktop ===== */
.features-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}

@media (min-width: 768px) {
  .features-grid { grid-template-columns: 1fr 1fr; }
}

.feature-block {
  background: #F9FAFB;
  border: 1px solid #E5E7EB;
  border-radius: 10px;
  padding: 20px;
  transition: box-shadow 0.2s;
}

.feature-block:hover {
  box-shadow: 0 4px 16px rgba(0,173,238,0.10);
  border-color: #B8E4F9;
}

.feature-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--c1);
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.feature-title::before {
  content: '';
  display: inline-block;
  width: 4px;
  height: 18px;
  background-color: var(--c6);
  border-radius: 2px;
  flex-shrink: 0;
}

.feature-list {
  padding-left: 18px;
  color: var(--c2);
  font-size: 15px;
}

.feature-list li { margin-bottom: 6px; }

/* ===== WEBSITE FOOTER ===== */
.site-footer {
  background-color: var(--c3);
  color: rgba(255,255,255,0.85);
  padding: 56px 40px;
  margin-top: auto;
}

.footer-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
}

@media (min-width: 768px) {
  .footer-inner { grid-template-columns: 1.5fr 1fr; }
}

.footer-brand {
  font-size: 17px;
  font-weight: 800;
  color: #FFF;
  margin-bottom: 16px;
}

.footer-copy {
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1px solid rgba(255,255,255,0.15);
  font-size: 14px;
  color: rgba(255,255,255,0.5);
  text-align: center;
  max-width: 1200px;
  margin: 32px auto 0;
}

/* ===== STATS GRID (Dashboard Seller) ===== */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin-bottom: 32px;
}

@media (min-width: 600px) {
  .stats-grid { grid-template-columns: repeat(4, 1fr); }
}

.stat-card {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 12px;
  padding: 20px 24px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  transition: box-shadow 0.2s;
}

.stat-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }

.stat-label {
  font-size: 14px;
  color: var(--c5);
  margin-bottom: 8px;
}

.stat-value {
  font-size: 26px;
  font-weight: 800;
  color: var(--c1);
}

/* ===== 2-COLUMN DASHBOARD GRID ===== */
.dashboard-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
}

@media (min-width: 960px) {
  .dashboard-grid { grid-template-columns: 1.2fr 1fr; }
}

/* ===== TIER ACCORDION (7 tầng) ===== */
.tier-accordion-item {
  border: 1px solid #E5E7EB;
  border-radius: 8px;
  margin-bottom: 10px;
  overflow: hidden;
  transition: box-shadow 0.2s;
}

.tier-accordion-item:hover { box-shadow: 0 2px 10px rgba(0,173,238,0.1); }

.tier-accordion-header {
  padding: 14px 20px;
  background-color: #F9FAFB;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  font-weight: 700;
  font-size: 15px;
  transition: background 0.15s;
}

.tier-accordion-header:hover { background-color: #EEF6FC; }

.tier-accordion-body {
  padding: 12px 20px;
  border-top: 1px solid #E5E7EB;
  background-color: #FFF;
  display: none;
}

.tier-accordion-item.open .tier-accordion-body { display: block; }
.tier-accordion-item.open .tier-accordion-header { background-color: #EEF6FC; }

.member-mini-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px dashed #E5E7EB;
  font-size: 15px;
}
.member-mini-row:last-child { border-bottom: none; }

/* ===== OTP BOXES (6 digits) ===== */
.otp-group {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin: 32px 0;
}

.otp-box {
  width: 56px;
  height: 64px;
  text-align: center;
  font-size: 26px;
  font-weight: 800;
  border: 2px solid var(--c7);
  border-radius: 8px;
  transition: border-color 0.15s;
}

.otp-box:focus { border-color: var(--c6); outline: none; }
.otp-group.error .otp-box { border-color: var(--err); background-color: #FFF5F5; }

/* ===== STEP PROGRESS BAR ===== */
.step-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 auto 32px;
  max-width: 400px;
  position: relative;
}

.step-bar::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0; right: 0;
  height: 2px;
  background-color: var(--c7);
  z-index: 1;
  transform: translateY(-50%);
}

.step-item {
  width: 38px; height: 38px;
  border-radius: 50%;
  background-color: #FFF;
  border: 2px solid var(--c7);
  color: var(--c5);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  font-size: 15px;
}

.step-item.active { border-color: var(--c6); background-color: var(--c6); color: #FFF; }
.step-item.done   { border-color: var(--c8); background-color: var(--c8); color: #FFF; }

/* ===== SHIPPING TRACKER ===== */
.shipping-steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20px 0;
  position: relative;
}

.shipping-step-node {
  text-align: center;
  font-size: 14px;
  color: var(--c5);
  z-index: 2;
  flex: 1;
}

.shipping-step-node.active  { color: var(--c6); font-weight: 700; }
.shipping-step-node.passed  { color: var(--c8); font-weight: 700; }

/* ===== ACTIVATION CODE BOX ===== */
.activation-code-box {
  background: linear-gradient(135deg, #FFFDF0 0%, #FFF9E0 100%);
  border: 2px dashed var(--c9);
  border-radius: 12px;
  padding: 32px 24px;
  text-align: center;
  margin: 24px 0;
}

.activation-code-text {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 26px;
  font-weight: 800;
  letter-spacing: 3px;
  color: var(--c1);
  margin: 16px 0;
  word-break: break-all;
}
