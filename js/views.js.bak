/**
 * Medigo Prototype - Render Views for 16 Screens (A0 -> A13, B1 -> B3)
 * Modern Website Layout (Responsive for Desktop & Mobile)
 */

const MedigoViews = {
  // Utility format tiền
  formatMoney: function(num) {
    return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".") + "đ";
  },

  // Common Header for Website
  renderWebHeader: function(activeTab = '') {
    const affId = MedigoStore.get('aff_id', '923983');
    return `
      <!-- Top Aff Notice Bar -->
      <div class="aff-notice-bar">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>Bạn đang xem qua link giới thiệu của thành viên <strong>${affId}</strong></span>
      </div>

      <!-- Main Navigation Web Header -->
      <header class="app-header">
        <div class="logo-brand" onclick="MedigoApp.navigate('A0')">
          <svg width="34" height="34" viewBox="0 0 120 120">
            <circle cx="60" cy="60" r="54" fill="#00ADEE"/>
            <text x="60" y="76" font-family="Arial" font-size="50" font-weight="bold" fill="#FFF" text-anchor="middle">M</text>
          </svg>
          <span>MEDIGO</span>
        </div>

        <ul class="web-nav-links">
          <li><a href="javascript:void(0)" onclick="MedigoApp.navigate('A0')" style="${activeTab==='A0'?'color:var(--c6);':''}">Trang chủ Sản phẩm</a></li>
          <li><a href="javascript:void(0)" onclick="MedigoApp.navigate('A13')" style="${activeTab==='A13'?'color:var(--c6);':''}">Đơn hàng & Mã của tôi</a></li>
          <li><a href="javascript:void(0)" onclick="MedigoApp.navigate('A10')" style="${activeTab==='A10'?'color:var(--c6);':''}">Kênh Seller (Affiliate)</a></li>
          <li><a href="javascript:void(0)" onclick="MedigoApp.navigate('B2')" style="${activeTab==='B2'?'color:var(--c6);':''}">Admin Vận hành</a></li>
        </ul>

        <div style="display: flex; align-items: center; gap: var(--s5);">
          <button class="cart-icon-btn" onclick="MedigoApp.navigate('A1')" title="Giỏ hàng">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
            <span class="cart-badge-count">1</span>
          </button>
        </div>
      </header>
    `;
  },

  // ----------------------------------------------------
  // A0: Landing Sản phẩm CN02 (Full Website Responsive Layout)
  // ----------------------------------------------------
  renderA0: function(container) {
    const config = MEDIGO_CONFIG;
    
    container.innerHTML = `
      <div class="web-wrapper">
        ${this.renderWebHeader('A0')}

        <!-- Product Hero 2-Column Desktop Layout -->
        <div class="product-hero-grid">
          <!-- Left Column: Image Carousel / Gallery -->
          <div>
            <div class="product-carousel">
              <img id="carousel-img" src="${config.product.images[0]}" alt="GoCare HW01">
              <div class="carousel-dots">
                <span class="carousel-dot active" onclick="MedigoViews.switchCarousel(0)"></span>
                <span class="carousel-dot" onclick="MedigoViews.switchCarousel(1)"></span>
                <span class="carousel-dot" onclick="MedigoViews.switchCarousel(2)"></span>
              </div>
            </div>
          </div>

          <!-- Right Column: Product Title, Pricing, Actions -->
          <div style="display: flex; flex-direction: column; justify-content: center;">
            <div class="product-meta-row">
              <span style="font-size: 15px;">Mã gói: <strong style="color: var(--c1);">${config.product.code}</strong></span>
              <span class="badge badge-active">${config.product.stockStatus}</span>
            </div>

            <h1 class="product-title">${config.product.name}</h1>

            <div class="product-price-tag">${this.formatMoney(config.product.price)}</div>

            <p style="color: var(--c2); font-size: 16px; margin-bottom: var(--s6);">
              Gói dịch vụ cao cấp bao gồm: <strong>01 đồng hồ thông minh HW01</strong> theo dõi nhịp tim/SOS gửi qua đơn vị vận chuyển + <strong>01 năm phần mềm Bác sĩ 24/7</strong> gửi qua Email.
            </p>

            <div style="display: flex; gap: var(--s5); align-items: center; margin-bottom: var(--s6);">
              <span style="font-weight: 700;">Số lượng:</span>
              <div class="quantity-control">
                <button class="qty-btn" onclick="MedigoViews.changeQty(-1)">-</button>
                <input type="text" id="product-qty" class="qty-input" value="1" readonly>
                <button class="qty-btn" onclick="MedigoViews.changeQty(1)">+</button>
              </div>
            </div>

            <div style="display: flex; gap: var(--s5); margin-bottom: var(--s6);">
              <button class="btn btn-secondary" style="flex:1; min-height: 50px;" onclick="MedigoApp.navigate('A1')">Thêm vào giỏ hàng</button>
              <button class="btn btn-primary" style="flex:1; min-height: 50px; font-size: 18px;" onclick="MedigoApp.navigate('A2')">MUA NGAY</button>
            </div>

            <button class="btn btn-secondary btn-full" onclick="alert('Đã sao chép link chia sẻ sản phẩm!')">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
              Chia sẻ link giới thiệu sản phẩm
            </button>
          </div>
        </div>

        <!-- Detail Features Box (8 items exact text from spec, 2-column grid on desktop) -->
        <div class="section-card">
          <h2 style="font-size: 24px; margin-bottom: var(--s4);">Chi tiết tính năng gói dịch vụ CN02</h2>
          <p style="font-size: 16px; margin-bottom: var(--s8); color: var(--c2);">
            Gói dịch vụ GOCARE - Bác sĩ 24/7 hỗ trợ, tư vấn sức khỏe (Ký hiệu CN02) được thiết kế với mục đích cung cấp cho người dùng những tính năng nâng cao của nền tảng và dịch vụ GOCARE...
          </p>

          <div class="features-grid">
            <div class="feature-block">
              <div class="feature-title">1. Theo dõi, quản lý sức khỏe cá nhân</div>
              <ul class="feature-list">
                <li>Người dùng được sử dụng nền tảng GOCARE để theo dõi, quản lý dữ liệu sức khỏe cá nhân với các tính năng nâng cao.</li>
              </ul>
            </div>

            <div class="feature-block">
              <div class="feature-title">2. Các tính năng thu nhận dữ liệu vào APP</div>
              <ul class="feature-list">
                <li>Thu nhận dữ liệu từ thiết bị đo kết nối đến APP</li>
                <li>Nhập dữ liệu thông tin sức khỏe thủ công</li>
                <li>Tải hồ sơ sức khỏe</li>
                <li>Nhập dữ liệu hồ sơ sức khỏe bằng chụp OCR</li>
              </ul>
            </div>

            <div class="feature-block">
              <div class="feature-title">3. Lưu trữ dữ liệu sức khỏe</div>
              <ul class="feature-list">
                <li>Thời gian lưu trữ kéo dài 10 năm</li>
                <li>Dung lượng lưu trữ tối đa 50MB</li>
              </ul>
            </div>

            <div class="feature-block">
              <div class="feature-title">4. Chia sẻ thông tin sức khỏe online</div>
              <ul class="feature-list">
                <li>Chia sẻ dữ liệu sức khỏe với Trung tâm TT247 GOCARE</li>
                <li>Thêm không giới hạn người thân theo dõi</li>
                <li>Không cho phép thêm Bác sĩ theo dõi</li>
              </ul>
            </div>

            <div class="feature-block">
              <div class="feature-title">5. Cảnh báo và hỗ trợ khẩn cấp (SOS)</div>
              <ul class="feature-list">
                <li>Tự động gửi cảnh báo chỉ số bất thường qua app</li>
                <li>Callbot tự động gọi thông báo người thân khi khẩn cấp</li>
                <li>Nút SOS trên APP gửi tín hiệu tức thì</li>
              </ul>
            </div>

            <div class="feature-block">
              <div class="feature-title">6. Theo dõi và chăm sóc sức khỏe từ xa</div>
              <ul class="feature-list">
                <li>Gọi lên TT247 GOCARE giải đáp thắc mắc sức khỏe</li>
                <li>Chủ động hỗ trợ từ xa khi phát hiện bất thường</li>
              </ul>
            </div>

            <div class="feature-block">
              <div class="feature-title">7. Dịch vụ Bác sĩ từ GOCARE</div>
              <ul class="feature-list">
                <li>Đội ngũ bác sĩ 24/7 luôn sẵn sàng hỗ trợ khi xảy ra sự cố khẩn cấp</li>
              </ul>
            </div>

            <div class="feature-block">
              <div class="feature-title">8. Tính năng nâng cao của nền tảng GOCARE</div>
              <ul class="feature-list">
                <li>Nhắc lịch uống thuốc & Người thân cùng theo dõi</li>
                <li>AI phân tích xu hướng bệnh lý kèm tư vấn bác sĩ</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Footer HGTECHS -->
        <div style="background-color: #F8FAFC; padding: var(--s10) var(--s8); border-top: 1px solid #E5E7EB; font-size: 15px; color: var(--c4);">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--s8); margin-bottom: var(--s8);">
            <div>
              <div style="font-weight: 800; color: var(--c1); font-size: 17px; margin-bottom: var(--s4);">${config.company.fullName}</div>
              <p style="margin-bottom: 6px;">📍 Địa chỉ: ${config.company.address}</p>
              <p style="margin-bottom: 6px;">📞 Điện thoại: ${config.company.phones.join(' · ')}</p>
              <p style="margin-bottom: 6px;">✉️ Email: ${config.company.email}</p>
              <p style="font-size: 13px; color: var(--c5); margin-top: var(--s3);">${config.company.license}</p>
            </div>
            <div>
              <div style="font-weight: 800; color: var(--c1); font-size: 17px; margin-bottom: var(--s4);">Danh mục chính sách</div>
              <div style="display: flex; flex-direction: column; gap: 8px;">
                ${config.policies.map(p => `<a href="javascript:void(0)" style="color: var(--c2); font-size: 15px;">• ${p}</a>`).join('')}
              </div>
            </div>
          </div>
        </div>
      </div>
    `;
  },

  switchCarousel: function(index) {
    const img = document.getElementById('carousel-img');
    if (img) img.src = MEDIGO_CONFIG.product.images[index];
    document.querySelectorAll('.carousel-dot').forEach((dot, i) => {
      dot.classList.toggle('active', i === index);
    });
  },

  changeQty: function(delta) {
    const input = document.getElementById('product-qty');
    if (input) {
      let val = parseInt(input.value) + delta;
      if (val < 1) val = 1;
      input.value = val;
    }
  },

  // ----------------------------------------------------
  // A1: Giỏ hàng Website
  // ----------------------------------------------------
  renderA1: function(container, isEmpty = false) {
    const config = MEDIGO_CONFIG;

    if (isEmpty) {
      container.innerHTML = `
        <div class="web-wrapper">
          ${this.renderWebHeader()}
          <div style="padding: var(--s11) var(--s8); text-align: center;">
            <svg width="90" height="90" fill="none" stroke="var(--c5)" stroke-width="1.5" viewBox="0 0 24 24"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
            <h2 style="margin: var(--s6) 0 var(--s3); color: var(--c1);">Giỏ hàng của bạn đang trống</h2>
            <p style="color: var(--c5); margin-bottom: var(--s8);">Hãy tham khảo gói sản phẩm sức khỏe tiêu chuẩn của GoCare.</p>
            <button class="btn btn-primary" onclick="MedigoApp.navigate('A0')">Xem sản phẩm ngay</button>
          </div>
        </div>
      `;
      return;
    }

    container.innerHTML = `
      <div class="web-wrapper">
        ${this.renderWebHeader()}
        
        <div style="padding: var(--s8); max-width: 900px; margin: 0 auto; width: 100%;">
          <h2 style="font-size: 24px; margin-bottom: var(--s7);">Giỏ hàng của bạn</h2>

          <div class="section-card" style="display: flex; gap: var(--s6); align-items: center; border: 1px solid #E5E7EB; border-radius: var(--r-lg); margin-bottom: var(--s7);">
            <img src="${config.product.images[0]}" alt="Thumb" style="width: 100px; height: 100px; object-fit: cover; border-radius: var(--r-md);">
            <div style="flex:1;">
              <div style="font-weight: 700; color: var(--c1); font-size: 17px;">${config.product.shortName}</div>
              <div class="text-price" style="margin: 6px 0; font-size: 20px;">${this.formatMoney(config.product.price)}</div>
              <div class="quantity-control">
                <button class="qty-btn" onclick="MedigoViews.changeQty(-1)">-</button>
                <input type="text" id="product-qty" class="qty-input" value="1" readonly>
                <button class="qty-btn" onclick="MedigoViews.changeQty(1)">+</button>
              </div>
            </div>
            <button class="btn btn-danger" style="padding: 8px 12px;" onclick="MedigoViews.renderA1(document.getElementById('app-root'), true)">
              Xóa khỏi giỏ
            </button>
          </div>

          <div class="section-card" style="border: 1px solid #E5E7EB; border-radius: var(--r-lg); margin-bottom: var(--s8);">
            <div style="display: flex; justify-content: space-between; margin-bottom: var(--s4); font-size: 16px;">
              <span>Tạm tính</span>
              <span style="font-weight: 700;">${this.formatMoney(config.product.price)}</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: var(--s4); font-size: 16px;">
              <span>Phí vận chuyển</span>
              <span style="color: var(--c5);">Sẽ tính ở bước thanh toán</span>
            </div>
            <hr style="border: none; border-top: 1px solid #E5E7EB; margin: var(--s6) 0;">
            <div style="display: flex; justify-content: space-between; font-size: 22px; font-weight: 800;">
              <span>Thành tiền</span>
              <span class="text-price">${this.formatMoney(config.product.price)}</span>
            </div>
          </div>

          <button class="btn btn-primary btn-full" style="min-height: 52px; font-size: 18px;" onclick="MedigoApp.navigate('A2')">Tiến hành thanh toán</button>
        </div>
      </div>
    `;
  },

  // ----------------------------------------------------
  // A2: Thông tin nhận hàng (Website Centered Form)
  // ----------------------------------------------------
  renderA2: function(container) {
    const config = MEDIGO_CONFIG;
    const seller = MEDIGO_MOCK_DATA.currentSeller;
    const affId = MedigoStore.get('aff_id', '923983');

    container.innerHTML = `
      <div class="web-wrapper">
        ${this.renderWebHeader()}

        <div style="padding: var(--s8); max-width: 800px; margin: 0 auto; width: 100%;">
          <h2 style="font-size: 26px; margin-bottom: var(--s7);">Thông tin nhận hàng & Thanh toán</h2>

          <form id="checkout-form" onsubmit="event.preventDefault(); MedigoApp.navigate('A3');">
            <div class="section-card" style="border: 1px solid #E5E7EB; border-radius: var(--r-lg); margin-bottom: var(--s7);">
              <h3 style="margin-bottom: var(--s6);">1. Thông tin người nhận</h3>
              
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--s5);">
                <div class="form-group">
                  <label>Họ và tên <span class="required">*</span></label>
                  <input type="text" class="form-control" value="${seller.fullName}" required>
                </div>

                <div class="form-group">
                  <label>Số điện thoại <span class="required">*</span></label>
                  <input type="tel" class="form-control" value="${seller.phone}" required>
                </div>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--s5);">
                <div class="form-group">
                  <label>Email <span class="required">*</span></label>
                  <input type="email" id="email-1" class="form-control" value="${seller.email}" required>
                </div>

                <!-- Tính năng bắt buộc theo Spec: Nhập lại Email xác nhận -->
                <div class="form-group">
                  <label>Nhập lại Email xác nhận <span class="required">*</span></label>
                  <input type="email" id="email-2" class="form-control" value="${seller.email}" required>
                </div>
              </div>

              <div class="bg-light-yellow" style="padding: 12px; border-radius: var(--r-md); font-size: 14px; margin-bottom: var(--s5); color: var(--c1);">
                ⚠️ <strong>Lưu ý quan trọng:</strong> Mã kích hoạt phần mềm sẽ được gửi trực tiếp tới Email này. Vui lòng kiểm tra thật kỹ trước khi thanh toán.
              </div>

              <div class="form-group">
                <label>Địa chỉ giao hàng <span class="required">*</span></label>
                <input type="text" class="form-control" value="${seller.address}" required>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--s4);">
                <div class="form-group">
                  <label>Tỉnh/Thành phố <span class="required">*</span></label>
                  <select class="form-control"><option>Hà Nội</option></select>
                </div>
                <div class="form-group">
                  <label>Quận/Huyện <span class="required">*</span></label>
                  <select class="form-control"><option>Quận Thanh Xuân</option></select>
                </div>
                <div class="form-group">
                  <label>Phường/Xã <span class="required">*</span></label>
                  <select class="form-control"><option>Phường Thanh Xuân Trung</option></select>
                </div>
              </div>
            </div>

            <div class="section-card" style="border: 1px solid #E5E7EB; border-radius: var(--r-lg); margin-bottom: var(--s7);">
              <h3 style="margin-bottom: var(--s4);">2. Mã giới thiệu</h3>
              <div class="form-group">
                <input type="text" class="form-control" value="${affId}">
                <span class="text-sm text-muted">Để trống nếu bạn không được ai giới thiệu.</span>
              </div>
            </div>

            <div class="section-card" style="border: 1px solid #E5E7EB; border-radius: var(--r-lg); margin-bottom: var(--s7);">
              <h3 style="margin-bottom: var(--s4);">3. Hình thức thanh toán</h3>
              <div style="border: 2px solid var(--c6); border-radius: var(--r-md); padding: var(--s6); background-color: #F0F9FF; display: flex; align-items: center; gap: var(--s5);">
                <input type="radio" checked readOnly style="width: 22px; height: 22px;">
                <div>
                  <strong style="color: var(--c1); font-size: 17px;">Chuyển khoản qua Mã QR (VietQR)</strong>
                  <div class="text-sm text-muted">Mã QR tự động xác nhận tức thì sau khi chuyển tiền thành công</div>
                </div>
              </div>
            </div>

            <div class="section-card" style="border: 1px solid #E5E7EB; border-radius: var(--r-lg); margin-bottom: var(--s8);">
              <h3 style="margin-bottom: var(--s4);">4. Tóm tắt đơn hàng</h3>
              <div style="display: flex; justify-content: space-between; font-size: 22px; font-weight: 800;">
                <span>Tổng tiền thanh toán</span>
                <span class="text-price">${this.formatMoney(config.product.price)}</span>
              </div>
            </div>

            <button type="submit" class="btn btn-primary btn-full" style="min-height: 52px; font-size: 18px;">Thanh toán ngay</button>
          </form>
        </div>
      </div>
    `;
  },

  // ----------------------------------------------------
  // A3: Thanh toán QR + Đếm ngược Website
  // ----------------------------------------------------
  renderA3: function(container) {
    const config = MEDIGO_CONFIG;
    let secondsLeft = config.qrPayment.timeoutSeconds;

    container.innerHTML = `
      <div class="web-wrapper" style="text-align: center;">
        ${this.renderWebHeader()}

        <div style="padding: var(--s10) var(--s8); max-width: 680px; margin: 0 auto; width: 100%;">
          <h2 style="font-size: 26px; margin-bottom: var(--s3);">Quét mã QR để thanh toán</h2>
          <p style="color: var(--c5); font-size: 16px;">Sử dụng ứng dụng Ngân hàng hoặc Ví điện tử của bạn</p>

          <div style="background: #FFF; border: 1px solid var(--c7); border-radius: var(--r-lg); padding: var(--s7); display: inline-block; margin: var(--s7) 0; box-shadow: var(--shadow-md);">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=GOCARE_MDG88492" alt="QR" style="width: 220px; height: 220px;">
          </div>

          <div style="margin-bottom: var(--s7);">
            <span style="font-size: 16px; color: var(--c5);">Mã QR hết hạn sau:</span>
            <div id="qr-timer" style="font-size: 32px; font-weight: 800; color: var(--c6);">15:00</div>
          </div>

          <div class="section-card" style="text-align: left; border: 1px solid #E5E7EB; border-radius: var(--r-lg); margin-bottom: var(--s7);">
            <div style="display: flex; justify-content: space-between; margin-bottom: var(--s4); font-size: 16px;">
              <span>Số tiền:</span>
              <strong class="text-price" style="font-size: 20px;">${this.formatMoney(config.product.price)}</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: var(--s4); align-items: center; font-size: 16px;">
              <span>Nội dung CK:</span>
              <div style="display: flex; align-items: center; gap: 8px;">
                <strong style="color: var(--c1); font-size: 18px;">MDG88492</strong>
                <button class="btn btn-secondary" style="padding: 4px 10px; min-height: 32px; font-size: 14px;" onclick="alert('Đã sao chép nội dung CK!')">Copy</button>
              </div>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 16px;">
              <span>Người nhận:</span>
              <strong>GoCare Medigo</strong>
            </div>
          </div>

          <div style="display: flex; align-items: center; justify-content: center; gap: 10px; color: var(--c9); font-weight: 700; font-size: 17px;">
            <span class="btn loading" style="padding:0; min-height:auto;"></span>
            <span>Đang chờ nhận tín hiệu thanh toán...</span>
          </div>

          <div style="margin-top: var(--s8);">
            <button class="btn" style="color: var(--c5);" onclick="MedigoApp.navigate('A5?state=expired')">Hủy đơn hàng này</button>
          </div>

          <div style="margin-top: var(--s10); padding: 12px; background: #F0FDF4; border: 1px dashed var(--c8); border-radius: var(--r-md);">
            <small style="color: var(--c8); font-weight: 700;">[MÔ PHỎNG KIỂM THỬ DEMO]</small><br>
            <button class="btn btn-success" style="margin-top: 6px;" onclick="MedigoApp.navigate('A4')">Mô phỏng Thanh toán Thành công -> Chuyển sang màn A4</button>
          </div>
        </div>
      </div>
    `;

    if (window.qrInterval) clearInterval(window.qrInterval);
    window.qrInterval = setInterval(() => {
      secondsLeft--;
      const timerEl = document.getElementById('qr-timer');
      if (!timerEl) { clearInterval(window.qrInterval); return; }

      const m = Math.floor(secondsLeft / 60).toString().padStart(2, '0');
      const s = (secondsLeft % 60).toString().padStart(2, '0');
      timerEl.textContent = `${m}:${s}`;

      if (secondsLeft < config.qrPayment.warningSeconds) {
        timerEl.style.color = "var(--err)";
      }
      if (secondsLeft <= 0) {
        clearInterval(window.qrInterval);
        MedigoApp.navigate('A5?state=expired');
      }
    }, 1000);
  },

  // ----------------------------------------------------
  // A4: Thanh toán Thành công + Popup Mời Seller
  // ----------------------------------------------------
  renderA4: function(container) {
    container.innerHTML = `
      <div class="web-wrapper" style="text-align: center;">
        ${this.renderWebHeader()}

        <div style="padding: var(--s10) var(--s8); max-width: 680px; margin: 0 auto; width: 100%;">
          <div style="width: 90px; height: 90px; background-color: #F4FBF0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto var(--s6); color: var(--c8);">
            <svg width="54" height="54" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
          </div>

          <h1 style="color: var(--c1); font-size: 28px;">Thanh toán thành công</h1>
          <p style="color: var(--c5); margin-top: 4px; font-size: 16px;">Mã đơn hàng: <strong>MDG-88492</strong></p>

          <div class="activation-code-box">
            <span class="badge badge-pending">Chờ kích hoạt</span>
            <div style="font-size: 15px; color: var(--c4); margin-top: 10px;">Mã kích hoạt phần mềm Bác sĩ 24/7</div>
            <div class="activation-code-text">GOCARE-CN02-9982-4410</div>
            <button class="btn btn-secondary" style="font-size: 15px;" onclick="alert('Đã sao chép mã kích hoạt!')">
              Sao chép mã phần mềm
            </button>
            <p style="font-size: 14px; color: var(--c5); margin-top: var(--s5);">
              Mã đã được gửi tới email của bạn. Mã sẽ được kích hoạt khi bạn nhận được đồng hồ HW01. Thời hạn 1 năm tính từ ngày kích hoạt.
            </p>
          </div>

          <div style="margin-top: var(--s8); display: flex; gap: var(--s5);">
            <button class="btn btn-primary" style="flex:1; min-height: 48px;" onclick="MedigoApp.navigate('A13')">Xem đơn hàng của tôi</button>
            <button class="btn btn-secondary" style="flex:1; min-height: 48px;" onclick="MedigoApp.navigate('A6')">Đăng ký làm Seller ngay</button>
          </div>
        </div>

        <div id="seller-invite-modal" class="modal-backdrop">
          <div class="modal-card" style="text-align: center;">
            <div style="font-size: 36px; margin-bottom: 8px;">🎁</div>
            <h2 style="margin-bottom: var(--s4);">Đăng ký thành viên Seller</h2>
            <p style="color: var(--c2); margin-bottom: var(--s8); font-size: 16px;">
              Bạn có muốn đăng ký làm seller Medigo để nhận hoa hồng giới thiệu hấp dẫn từ GoCare không?
            </p>
            <div style="display: flex; flex-direction: column; gap: var(--s4);">
              <button class="btn btn-primary btn-full" onclick="MedigoApp.navigate('A6')">Đăng ký thành viên ngay</button>
              <button class="btn" style="color: var(--c5);" onclick="document.getElementById('seller-invite-modal').classList.remove('active')">Không, thoát ra</button>
            </div>
          </div>
        </div>
      </div>
    `;

    setTimeout(() => {
      const modal = document.getElementById('seller-invite-modal');
      if (modal) modal.classList.add('active');
    }, 1000);
  },

  // ----------------------------------------------------
  // A5: Thanh toán thất bại / QR hết hạn / Đang xác nhận
  // ----------------------------------------------------
  renderA5: function(container, stateParam = 'expired') {
    const config = MEDIGO_CONFIG;

    let iconColor = "var(--err)";
    let title = "Mã QR đã hết hạn";
    let desc = "Thời gian thực hiện giao dịch đã kết thúc. Vui lòng tạo mã QR mới.";
    let buttonsHTML = `
      <button class="btn btn-primary btn-full" onclick="MedigoApp.navigate('A3')">Tạo mã mới</button>
      <button class="btn btn-secondary btn-full" onclick="MedigoApp.navigate('A1')">Quay lại giỏ hàng</button>
    `;

    if (stateParam === 'failed') {
      title = "Thanh toán không thành công";
      desc = "Giao dịch bị gián đoạn hoặc không thành công. Vui lòng kiểm tra lại tài khoản.";
      buttonsHTML = `
        <button class="btn btn-primary btn-full" onclick="MedigoApp.navigate('A3')">Thử lại</button>
        <button class="btn btn-secondary btn-full" onclick="alert('Hotline: 1900 6868')">Liên hệ hỗ trợ</button>
      `;
    } else if (stateParam === 'confirming') {
      iconColor = "var(--c9)";
      title = "Đang xác nhận thanh toán";
      desc = "Hệ thống đang đối soát dữ liệu ngân hàng. Quá trình có thể mất vài phút...";
      buttonsHTML = `
        <div class="btn loading" style="color: var(--c6); font-weight: 700;">Đang xử lý...</div>
      `;
    }

    container.innerHTML = `
      <div class="web-wrapper" style="text-align: center;">
        ${this.renderWebHeader()}

        <div style="padding: var(--s10) var(--s8); max-width: 600px; margin: 0 auto; width: 100%;">
          <div style="display: flex; gap: 6px; justify-content: center; margin-bottom: var(--s8);">
            <button class="btn btn-secondary" style="font-size: 13px; padding: 4px 10px;" onclick="MedigoViews.renderA5(document.getElementById('app-root'), 'expired')">QR hết hạn</button>
            <button class="btn btn-secondary" style="font-size: 13px; padding: 4px 10px;" onclick="MedigoViews.renderA5(document.getElementById('app-root'), 'failed')">Thất bại</button>
            <button class="btn btn-secondary" style="font-size: 13px; padding: 4px 10px;" onclick="MedigoViews.renderA5(document.getElementById('app-root'), 'confirming')">Đang xác nhận</button>
          </div>

          <div style="width: 80px; height: 80px; border-radius: 50%; background-color: #FFF0F0; display: flex; align-items: center; justify-content: center; margin: 0 auto var(--s6); color: ${iconColor};">
            <svg width="44" height="44" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>

          <h2 style="color: var(--c1); margin-bottom: var(--s3); font-size: 24px;">${title}</h2>
          <p style="color: var(--c5); margin-bottom: var(--s8); font-size: 16px;">${desc}</p>

          <div style="display: flex; flex-direction: column; gap: var(--s4);">
            ${buttonsHTML}
          </div>

          <div style="margin-top: var(--s10); font-size: 15px; color: var(--c5);">
            Tổng đài hỗ trợ 24/7: <strong style="color: var(--c6);">${config.company.hotline}</strong>
          </div>
        </div>
      </div>
    `;
  },

  // ----------------------------------------------------
  // A6 -> A9: Luồng Đăng ký Seller Website
  // ----------------------------------------------------
  renderA6: function(container) {
    const seller = MEDIGO_MOCK_DATA.currentSeller;

    container.innerHTML = `
      <div class="web-wrapper">
        ${this.renderWebHeader()}

        <div style="padding: var(--s8); max-width: 800px; margin: 0 auto; width: 100%;">
          <div class="step-bar">
            <div class="step-item active">1</div>
            <div class="step-item">2</div>
            <div class="step-item">3</div>
          </div>
          <h2 style="text-align: center; margin-bottom: var(--s7);">Bước 1/3 · Thông tin cá nhân & Nhận hoa hồng</h2>

          <div class="bg-light-blue" style="padding: var(--s5); border-radius: var(--r-md); font-size: 15px; margin-bottom: var(--s7);">
            ℹ️ Chúng tôi đã điền sẵn thông tin từ đơn hàng của bạn. Vui lòng kiểm tra lại.
          </div>

          <form onsubmit="event.preventDefault(); MedigoApp.navigate('A7');">
