              <div class="form-group">
                <label>Họ và tên <span class="required">*</span></label>
                <input type="text" class="form-control" value="${seller.fullName}" required>
              </div>
              <div class="form-group">
                <label>Số điện thoại <span class="required">*</span></label>
                <input type="tel" class="form-control" value="${seller.phone}" required>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--s5);">
              <div class="form-group">
                <label>Email <span class="required">*</span></label>
                <input type="email" class="form-control" value="${seller.email}" required>
              </div>
              <div class="form-group">
                <label>Số CCCD <span class="required">*</span></label>
                <input type="text" class="form-control" value="${seller.cccd}" required>
              </div>
            </div>

            <h3 style="margin: var(--s8) 0 var(--s5);">Thông tin nhận hoa hồng</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--s5);">
              <div class="form-group">
                <label>Ngân hàng <span class="required">*</span></label>
                <select class="form-control"><option>Vietcombank</option><option>BIDV</option><option>Techcombank</option></select>
              </div>
              <div class="form-group">
                <label>Số tài khoản <span class="required">*</span></label>
                <input type="text" class="form-control" value="${seller.bankAccountNo}" required>
              </div>
              <div class="form-group">
                <label>Chủ tài khoản <span class="required">*</span></label>
                <input type="text" class="form-control" value="${seller.bankAccountOwner}" required>
              </div>
            </div>

            <button type="submit" class="btn btn-primary btn-full" style="margin-top: var(--s7); min-height: 50px;">Tiếp tục sang bước 2</button>
          </form>
        </div>
      </div>
    `;
  },

  renderA7: function(container) {
    const seller = MEDIGO_MOCK_DATA.currentSeller;
    let resendSeconds = MEDIGO_CONFIG.otp.resendSeconds;

    container.innerHTML = `
      <div class="web-wrapper" style="text-align: center;">
        ${this.renderWebHeader()}

        <div style="padding: var(--s8); max-width: 600px; margin: 0 auto; width: 100%;">
          <div class="step-bar">
            <div class="step-item done">✓</div>
            <div class="step-item active">2</div>
            <div class="step-item">3</div>
          </div>
          
          <h2 style="margin-bottom: 4px; font-size: 24px;">Xác thực OTP</h2>
          <p style="color: var(--c5); font-size: 16px; margin-bottom: var(--s6);">Bước 2/3 · Mã xác nhận đã gửi tới <strong>${seller.maskedPhone}</strong></p>

          <div id="otp-container" class="otp-group">
            <input type="text" maxlength="1" class="otp-box" value="1">
            <input type="text" maxlength="1" class="otp-box" value="2">
            <input type="text" maxlength="1" class="otp-box" value="3">
            <input type="text" maxlength="1" class="otp-box" value="4">
            <input type="text" maxlength="1" class="otp-box" value="5">
            <input type="text" maxlength="1" class="otp-box" value="6">
          </div>

          <div style="margin-bottom: var(--s8); font-size: 15px; color: var(--c5);">
            Không nhận được mã? <button id="resend-btn" class="btn" disabled style="padding:0; color: var(--c5); min-height:auto;">Gửi lại (${resendSeconds}s)</button>
          </div>

          <div style="display: flex; gap: var(--s5);">
            <button class="btn btn-secondary" style="flex:1;" onclick="MedigoApp.navigate('A6')">Quay lại</button>
            <button class="btn btn-primary" style="flex:1;" onclick="MedigoApp.navigate('A8')">Xác nhận OTP</button>
          </div>
        </div>
      </div>
    `;

    if (window.otpInterval) clearInterval(window.otpInterval);
    window.otpInterval = setInterval(() => {
      resendSeconds--;
      const btn = document.getElementById('resend-btn');
      if (!btn) { clearInterval(window.otpInterval); return; }

      if (resendSeconds > 0) {
        btn.textContent = `Gửi lại (${resendSeconds}s)`;
      } else {
        btn.disabled = false;
        btn.style.color = "var(--c6)";
        btn.textContent = "Gửi lại ngay";
        clearInterval(window.otpInterval);
      }
    }, 1000);
  },

  renderA8: function(container) {
    container.innerHTML = `
      <div class="web-wrapper">
        ${this.renderWebHeader()}

        <div style="padding: var(--s8); max-width: 760px; margin: 0 auto; width: 100%;">
          <div class="step-bar">
            <div class="step-item done">✓</div>
            <div class="step-item done">✓</div>
            <div class="step-item active">3</div>
          </div>

          <h2 style="text-align: center; margin-bottom: var(--s7);">Bước 3/3 · Vui lòng đọc và xác nhận điều khoản</h2>

          <div style="height: 280px; overflow-y: auto; border: 1px solid var(--c7); border-radius: var(--r-md); padding: var(--s7); font-size: 15px; color: var(--c2); background: #FAF9F6; margin-bottom: var(--s6);">
            <h4 style="margin-bottom: 10px; font-size: 17px;">ĐIỀU KHỎAN CHƯƠNG TRÌNH AFFILIATE MEDIGO — GOCARE</h4>
            <p>Bằng việc tích chọn xác nhận, bạn đồng ý với chính sách hoa hồng 7 tầng, quy định về tuyến trên/tuyến dưới, và các điều kiện rút tiền được GoCare quy định.</p>
            <br>
            <p>1. Hoa hồng được hạch toán khi đơn hàng hoàn tất thanh toán.</p>
            <p>2. Không vi phạm các chính sách truyền thông thương hiệu.</p>
            <p>3. Thuế TNCN sẽ được khấu trừ 10% theo quy định pháp luật hiện hành đối với khoản thu nhập hoa hồng.</p>
          </div>

          <label style="display: flex; gap: 12px; align-items: flex-start; cursor: pointer; margin-bottom: var(--s8);">
            <input type="checkbox" id="terms-check" style="width: 22px; height: 22px; margin-top: 2px;" onchange="document.getElementById('confirm-act-btn').disabled = !this.checked">
            <span style="font-size: 16px;">Tôi đã đọc và đồng ý với toàn bộ điều khoản tham gia chương trình affiliate Medigo.</span>
          </label>

          <div style="display: flex; gap: var(--s5);">
            <button class="btn btn-secondary" style="flex:1;" onclick="MedigoApp.navigate('A7')">Quay lại</button>
            <button id="confirm-act-btn" class="btn btn-primary" disabled style="flex:1; min-height: 50px;" onclick="MedigoApp.navigate('A9')">Xác nhận & Kích hoạt tài khoản</button>
          </div>
        </div>
      </div>
    `;
  },

  renderA9: function(container) {
    const seller = MEDIGO_MOCK_DATA.currentSeller;
    const refLink = `gocare.vn/san-pham/CN02?aff_id=${seller.aff_id}`;

    container.innerHTML = `
      <div class="web-wrapper" style="text-align: center;">
        ${this.renderWebHeader()}

        <div style="padding: var(--s10) var(--s8); max-width: 680px; margin: 0 auto; width: 100%;">
          <div style="width: 90px; height: 90px; background-color: #F4FBF0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto var(--s6); color: var(--c8);">
            <svg width="54" height="54" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
          </div>

          <h1 style="color: var(--c1); font-size: 28px;">Kích hoạt thành công</h1>
          <p style="color: var(--c5); margin-top: 4px; font-size: 17px;">Bạn đã chính thức là seller Medigo</p>

          <div class="section-card" style="margin: var(--s8) 0; border: 1px solid var(--c7); border-radius: var(--r-lg); text-align: left;">
            <div style="margin-bottom: var(--s6);">
              <span class="text-sm text-muted">Mã giới thiệu (aff_id)</span>
              <div style="font-size: 28px; font-weight: 800; color: var(--c6); font-family: monospace;">${seller.aff_id}</div>
            </div>

            <div>
              <span class="text-sm text-muted">Link giới thiệu sản phẩm</span>
              <div style="font-size: 16px; font-weight: 700; color: var(--c1); word-break: break-all; margin: 6px 0;">${refLink}</div>
              <div style="display: flex; gap: var(--s4); margin-top: var(--s5);">
                <button class="btn btn-secondary" style="flex:1;" onclick="alert('Đã sao chép link!')">Sao chép link</button>
                <button class="btn btn-primary" style="flex:1;" onclick="if(navigator.share){navigator.share({title:'Medigo',url:'https://${refLink}'})}else{alert('Chia sẻ link!')}">Chia sẻ link</button>
              </div>
            </div>
          </div>

          <button class="btn btn-primary btn-full" style="min-height: 50px; font-size: 18px;" onclick="MedigoApp.navigate('A10')">Vào dashboard Seller</button>
        </div>
      </div>
    `;
  },

  // ----------------------------------------------------
  // A10: Dashboard Seller (2-Column Desktop Responsive Layout)
  // ----------------------------------------------------
  renderA10: function(container) {
    const seller = MEDIGO_MOCK_DATA.currentSeller;
    const downlines = MEDIGO_MOCK_DATA.downlineTiers;
    const history = MEDIGO_MOCK_DATA.sellerCommissionHistory;
    const refLink = `gocare.vn/san-pham/CN02?aff_id=${seller.aff_id}`;

    container.innerHTML = `
      <div class="web-wrapper">
        ${this.renderWebHeader('A10')}

        <div style="padding: var(--s8);">
          <!-- Top Header Info -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--s7); flex-wrap: wrap; gap: var(--s4);">
            <div>
              <h2 style="font-size: 26px;">Dashboard Seller · ${seller.fullName}</h2>
              <div class="text-sm text-muted">Mã giới thiệu (aff_id): <strong style="color: var(--c6); font-size: 16px;">${seller.aff_id}</strong></div>
            </div>
            <button class="btn btn-primary" onclick="MedigoApp.navigate('A12')">Yêu cầu rút tiền</button>
          </div>

          <!-- Referral Link Banner -->
          <div class="bg-light-blue" style="padding: var(--s6); border-radius: var(--r-lg); margin-bottom: var(--s8); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--s4);">
            <div>
              <div class="text-sm text-muted">Link giới thiệu trực tiếp của bạn:</div>
              <div style="font-weight: 700; color: var(--c1); font-size: 17px; word-break: break-all;">${refLink}</div>
            </div>
            <div style="display: flex; gap: var(--s3);">
              <button class="btn btn-secondary" onclick="alert('Đã copy!')">Copy link</button>
              <button class="btn btn-primary" onclick="alert('Chia sẻ!')">Chia sẻ</button>
            </div>
          </div>

          <!-- 4 Stats Cards -->
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-label">Tổng đơn hàng</div>
              <div class="stat-value">${seller.totalOrders}</div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Điểm tích lũy</div>
              <div class="stat-value">${seller.totalPoints}</div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Hạng hiện tại</div>
              <div class="stat-value"><span class="rank-badge rank-silver">${seller.rank}</span></div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Số dư khả dụng</div>
              <div class="stat-value" style="color: var(--c6);">${this.formatMoney(seller.availableBalance)}</div>
            </div>
          </div>

          <!-- Desktop 2-Column Grid: Left (Chart & History), Right (7 Tầng Downlines) -->
          <div class="dashboard-grid">
            <div>
              <!-- Biểu đồ Xu hướng hoa hồng 7 ngày -->
              <div class="section-card" style="border: 1px solid #E5E7EB; border-radius: var(--r-lg); margin-bottom: var(--s8);">
                <h3 style="margin-bottom: var(--s5);">Xu hướng hoa hồng · 7 ngày qua</h3>
                <div style="display: flex; align-items: flex-end; justify-content: space-between; height: 140px; padding-top: 20px;">
                  ${MEDIGO_MOCK_DATA.commissionTrend7Days.map(item => {
                    const h = Math.round((item.amount / 2000000) * 100) + 12;
                    return `
                      <div style="display: flex; flex-direction: column; align-items: center; flex: 1;">
                        <div style="width: 20px; height: ${h}px; background-color: var(--c6); border-radius: 4px 4px 0 0;"></div>
                        <span style="font-size: 12px; color: var(--c5); margin-top: 8px;">${item.day.split(' ')[0]}</span>
                      </div>
                    `;
                  }).join('')}
                </div>
              </div>

              <!-- Lịch sử Đơn hàng & Hoa hồng -->
              <div class="section-card" style="border: 1px solid #E5E7EB; border-radius: var(--r-lg);">
                <h3 style="margin-bottom: var(--s5);">Lịch sử phát sinh hoa hồng</h3>
                ${history.map(item => `
                  <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px dashed #E5E7EB;">
                    <div>
                      <strong style="color: var(--c1);">Đơn #${item.id}</strong> · <span class="text-sm text-muted">${item.level}</span>
                      <div class="text-sm text-muted">${item.date}</div>
                    </div>
                    <div style="text-align: right;">
                      <strong style="color: var(--c8); font-size: 17px;">+${this.formatMoney(item.amount)}</strong>
                      <div><span class="badge" style="background-color: var(${item.statusColor}); font-size: 12px;">${item.status}</span></div>
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>

            <!-- Right Column: Tuyến dưới 7 Tầng Aggregate -->
            <div>
              <div class="section-card" style="border: 1px solid #E5E7EB; border-radius: var(--r-lg);">
                <h3 style="margin-bottom: var(--s3);">Mạng lưới tuyến dưới (7 Tầng)</h3>
                <p class="text-sm text-muted" style="margin-bottom: var(--s6);">Xem danh sách tổng hợp số lượng & doanh thu theo tầng.</p>

                ${downlines.map(tier => `
                  <div class="tier-accordion-item" id="tier-item-${tier.level}">
                    <div class="tier-accordion-header" onclick="document.getElementById('tier-item-${tier.level}').classList.toggle('open')">
                      <div>
                        <strong style="color: var(--c6); font-size: 16px;">Tầng ${tier.level}</strong> · ${tier.memberCount} thành viên
                      </div>
                      <div style="display: flex; align-items: center; gap: 10px;">
                        <strong style="color: var(--c8);">${this.formatMoney(tier.totalCommission)}</strong>
                        <span>▼</span>
                      </div>
                    </div>
                    <div class="tier-accordion-body">
                      ${tier.members.map(m => `
                        <div class="member-mini-row">
                          <strong>${m.shortName}</strong>
                          <span class="text-sm text-muted">Ngày: ${m.joinDate}</span>
                          <span>${m.orderCount} đơn</span>
                        </div>
                      `).join('')}
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>
          </div>
        </div>
      </div>
    `;
  },

  // ----------------------------------------------------
  // A11: Đăng nhập Seller Website
  // ----------------------------------------------------
  renderA11: function(container) {
    container.innerHTML = `
      <div class="web-wrapper" style="text-align: center;">
        ${this.renderWebHeader()}

        <div style="padding: var(--s10) var(--s8); max-width: 500px; margin: 0 auto; width: 100%;">
          <div style="margin-bottom: var(--s8);">
            <h1 style="color: var(--c1); font-size: 28px;">Đăng nhập Kênh Seller</h1>
            <p style="color: var(--c5); font-size: 16px; margin-top: 6px;">Dành riêng cho thành viên giới thiệu Medigo</p>
          </div>

          <form onsubmit="event.preventDefault(); MedigoApp.navigate('A7');" style="text-align: left;">
            <div class="form-group">
              <label>Số điện thoại đã đăng ký <span class="required">*</span></label>
              <input type="tel" class="form-control" value="0908123456" required>
            </div>

            <button type="submit" class="btn btn-primary btn-full" style="margin-top: var(--s6); min-height: 48px;">Gửi mã OTP đăng nhập</button>
          </form>

          <div style="margin-top: var(--s9); font-size: 16px;">
            <a href="javascript:void(0)" onclick="MedigoApp.navigate('A0')">Chưa có tài khoản? Tìm hiểu cách tham gia</a>
          </div>
        </div>
      </div>
    `;
  },

  // ----------------------------------------------------
  // A12: Yêu cầu rút tiền Website
  // ----------------------------------------------------
  renderA12: function(container) {
    const seller = MEDIGO_MOCK_DATA.currentSeller;
    const config = MEDIGO_CONFIG.withdrawal;

    container.innerHTML = `
      <div class="web-wrapper">
        ${this.renderWebHeader()}

        <div style="padding: var(--s8); max-width: 720px; margin: 0 auto; width: 100%;">
          <h2 style="font-size: 26px; margin-bottom: var(--s7);">Yêu cầu rút tiền hoa hồng</h2>

          <div class="bg-light-blue" style="padding: var(--s8); border-radius: var(--r-lg); text-align: center; margin-bottom: var(--s8);">
            <span class="text-sm text-muted" style="font-size: 15px;">Số dư khả dụng hiện tại</span>
            <div style="font-size: 36px; font-weight: 800; color: var(--c6); margin-top: 4px;">${this.formatMoney(seller.availableBalance)}</div>
          </div>

          <form onsubmit="event.preventDefault(); alert('Đã gửi yêu cầu rút tiền thành công!'); MedigoApp.navigate('A10');">
            <div class="form-group">
              <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                <label>Số tiền muốn rút <span class="required">*</span></label>
                <button type="button" class="btn" style="padding:0; min-height:auto; color: var(--c6); font-size: 15px;" onclick="document.getElementById('withdraw-amt').value = ${seller.availableBalance}">Rút toàn bộ số dư</button>
              </div>
              <input type="number" id="withdraw-amt" class="form-control" value="3000000" min="${config.minAmount}" required>
              <span class="text-sm text-muted">Ngưỡng tối thiểu mỗi lần rút: ${this.formatMoney(config.minAmount)}</span>
            </div>

            <div class="section-card" style="border: 1px solid #E5E7EB; border-radius: var(--r-lg); margin: var(--s7) 0;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--s5);">
                <strong style="font-size: 17px;">Tài khoản ngân hàng thụ hưởng</strong>
                <a href="javascript:void(0)" style="font-size: 15px;" onclick="MedigoApp.navigate('A6')">Thay đổi thông tin</a>
              </div>
              <div style="font-size: 16px; color: var(--c2);">
                <p>Ngân hàng: <strong>${seller.bankName}</strong></p>
                <p>Số tài khoản: <strong>${seller.maskedBankAccountNo}</strong></p>
                <p>Chủ tài khoản: <strong>${seller.bankAccountOwner}</strong></p>
              </div>
            </div>

            <div class="section-card" style="border: 1px solid #E5E7EB; border-radius: var(--r-lg); margin-bottom: var(--s8);">
              <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 16px;">
                <span>Số tiền yêu cầu rút:</span>
                <strong style="color: var(--c1);">3.000.000đ</strong>
              </div>
              <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 16px;">
                <span>Thuế TNCN tạm tính (10%):</span>
                <strong style="color: var(--err);">-300.000đ</strong>
              </div>
              <hr style="border: none; border-top: 1px dashed #E5E7EB; margin: 10px 0;">
              <div style="display: flex; justify-content: space-between; font-size: 20px; font-weight: 800;">
                <span>Số tiền thực nhận chuyển khoản:</span>
                <strong style="color: var(--c8);">${this.formatMoney(2700000)}</strong>
              </div>
            </div>

            <button type="submit" class="btn btn-primary btn-full" style="min-height: 50px; font-size: 18px;">Gửi yêu cầu rút tiền</button>
          </form>
        </div>
      </div>
    `;
  },

  // ----------------------------------------------------
  // A13: Quản lý Đơn hàng & Mã kích hoạt của Tôi Website
  // ----------------------------------------------------
  renderA13: function(container) {
    const orders = MEDIGO_MOCK_DATA.customerOrders;

    container.innerHTML = `
      <div class="web-wrapper">
        ${this.renderWebHeader('A13')}

        <div style="padding: var(--s8); max-width: 900px; margin: 0 auto; width: 100%;">
          <h2 style="font-size: 26px; margin-bottom: var(--s7);">Đơn hàng & Mã kích hoạt của tôi</h2>

          ${orders.map(order => `
            <div class="section-card" style="border: 1px solid #E5E7EB; border-radius: var(--r-lg); margin-bottom: var(--s8);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--s5);">
                <strong style="font-size: 18px; color: var(--c1);">Đơn hàng #${order.orderId}</strong>
                <span class="text-sm text-muted">${order.orderDate}</span>
              </div>
              <div style="font-weight: 700; color: var(--c1); font-size: 17px; margin-bottom: var(--s6);">${order.productName}</div>

              <!-- Phần 1: Tiến trình Vận chuyển Đồng hồ HW01 -->
              <div style="background: #F8FAFC; padding: var(--s6); border-radius: var(--r-md); margin-bottom: var(--s6);">
                <div style="font-weight: 700; font-size: 15px; margin-bottom: var(--s4);">📦 Giao nhận Đồng hồ HW01 — ${order.shipping.carrier}</div>
                <div class="shipping-steps">
                  <div class="shipping-step-node ${order.shipping.currentStep >= 1 ? 'passed' : ''}">Chờ đóng gói</div>
                  <div class="shipping-step-node ${order.shipping.currentStep >= 2 ? 'passed' : ''}">Đã gửi hàng</div>
                  <div class="shipping-step-node ${order.shipping.currentStep === 3 ? 'active' : (order.shipping.currentStep > 3 ? 'passed' : '')}">Đang giao</div>
                  <div class="shipping-step-node ${order.shipping.currentStep === 4 ? 'passed' : ''}">Đã nhận máy</div>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px;">
                  <span class="text-sm text-muted">Mã vận đơn: <strong>${order.shipping.trackingCode}</strong></span>
                  <button class="btn btn-secondary" style="padding: 4px 12px; min-height: 32px; font-size: 13px;" onclick="alert('Mở trang theo dõi hành trình!')">Theo dõi đơn vận chuyển</button>
                </div>
              </div>

              <!-- Phần 2: Trạng thái Mã kích hoạt phần mềm -->
              <div style="padding: var(--s6); border-radius: var(--r-md); border: 1px solid #E5E7EB;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--s4);">
                  <strong style="font-size: 16px;">🔑 Mã phần mềm Bác sĩ 24/7</strong>
                  <span class="badge ${order.activationKey.status === 'Chờ kích hoạt' ? 'badge-pending' : (order.activationKey.status === 'Đã kích hoạt' ? 'badge-active' : 'badge-pending')}" style="font-size: 14px; padding: 4px 10px;">${order.activationKey.status}</span>
                </div>

                ${order.activationKey.status === 'Chờ kích hoạt' ? `
                  <div style="font-family: monospace; font-size: 22px; font-weight: 800; text-align: center; margin: 12px 0; color: var(--c1);">${order.activationKey.maskedCode}</div>
                  <button class="btn btn-primary btn-full" style="margin-top: 10px; min-height: 48px; font-size: 16px;" onclick="MedigoViews.showActivationModal('${order.orderId}')">Tôi đã nhận được đồng hồ — Kích hoạt ngay</button>
                  <span class="text-sm text-muted" style="display: block; text-align: center; margin-top: 8px;">Thời hạn 1 năm bắt đầu tính từ khi bạn bấm kích hoạt.</span>
                ` : ''}

                ${order.activationKey.status === 'Đã kích hoạt' ? `
                  <div style="font-family: monospace; font-size: 22px; font-weight: 800; margin: 6px 0; color: var(--c1);">${order.activationKey.code}</div>
                  <div class="text-sm text-muted" style="font-size: 15px;">Ngày kích hoạt: ${order.activationKey.activatedDate} · Ngày hết hạn: ${order.activationKey.expiredDate}</div>
                  <div style="background: #E5E7EB; height: 10px; border-radius: 5px; overflow: hidden; margin: 10px 0;">
                    <div style="background: var(--c8); width: 78%; height: 100%;"></div>
                  </div>
                  <div style="font-weight: 700; color: var(--c8); font-size: 15px;">Thời hạn còn lại: ${order.activationKey.daysRemaining} ngày sử dụng</div>
                ` : ''}

                ${order.activationKey.status === 'Sắp hết hạn' ? `
                  <div style="font-family: monospace; font-size: 22px; font-weight: 800; margin: 6px 0; color: var(--c1);">${order.activationKey.code}</div>
                  <div class="text-sm text-muted" style="font-size: 15px;">Ngày hết hạn: ${order.activationKey.expiredDate}</div>
                  <div style="font-weight: 700; color: var(--c9); font-size: 15px; margin: 6px 0;">Cảnh báo: Sắp hết hạn (Còn ${order.activationKey.daysRemaining} ngày)</div>
                  <button class="btn btn-primary btn-full" onclick="alert('Đã gửi yêu cầu gia hạn!')">Gia hạn gói dịch vụ ngay</button>
                ` : ''}
              </div>

              <div style="text-align: center; margin-top: var(--s5);">
                <button class="btn" style="color: var(--c6); font-size: 15px; padding:0; min-height:auto;" onclick="alert('Mã đã được gửi lại vào Email của bạn!')">Gửi lại mã kích hoạt qua email</button>
              </div>
            </div>
          `).join('')}
        </div>

        <div id="activation-modal" class="modal-backdrop">
          <div class="modal-card">
            <h3 style="margin-bottom: var(--s4);">Xác nhận kích hoạt mã phần mềm</h3>
            <p style="color: var(--c2); margin-bottom: var(--s8); font-size: 16px;">
              Sau khi kích hoạt, thời hạn 1 năm sẽ bắt đầu và bạn sẽ <strong>không thể đổi trả sản phẩm</strong>. Bạn chắc chắn muốn kích hoạt?
            </p>
            <div style="display: flex; gap: var(--s4);">
              <button class="btn btn-secondary" style="flex:1;" onclick="document.getElementById('activation-modal').classList.remove('active')">Hủy</button>
              <button class="btn btn-primary" style="flex:1;" onclick="alert('Kích hoạt thành công!'); document.getElementById('activation-modal').classList.remove('active'); MedigoApp.navigate('A13');">Xác nhận kích hoạt</button>
            </div>
          </div>
        </div>
      </div>
    `;
  },

  showActivationModal: function(orderId) {
    const modal = document.getElementById('activation-modal');
    if (modal) modal.classList.add('active');
  },

  // ----------------------------------------------------
  // B1: Đăng nhập Admin
  // ----------------------------------------------------
  renderB1: function(container) {
    container.innerHTML = `
      <div class="admin-login-wrapper">
        <div class="admin-login-card">
          <div style="text-align: center; margin-bottom: var(--s8);">
            <svg width="56" height="56" viewBox="0 0 120 120" style="margin-bottom: 8px;">
              <circle cx="60" cy="60" r="54" fill="#00ADEE"/>
              <text x="60" y="76" font-family="Arial" font-size="50" font-weight="bold" fill="#FFF" text-anchor="middle">M</text>
            </svg>
            <h1 style="color: var(--c1);">Medigo Admin</h1>
            <p style="color: var(--c5); font-size: 15px;">Khu vực vận hành nội bộ GoCare</p>
          </div>

          <form onsubmit="event.preventDefault(); MedigoApp.navigate('B2');">
            <div class="form-group">
              <label>Email / Username</label>
              <input type="text" class="form-control" value="admin@gocare.vn" required>
            </div>
            <div class="form-group">
              <label>Mật khẩu</label>
              <input type="password" class="form-control" value="••••••••" required>
            </div>

            <button type="submit" class="btn btn-primary btn-full" style="margin-top: var(--s6);">Đăng nhập</button>
          </form>

          <div style="margin-top: var(--s8); text-align: center; font-size: 13px; color: var(--c5);">
            Hệ thống thao tác tài chính — tách biệt hoàn toàn với đăng nhập seller.
          </div>
        </div>
      </div>
    `;
  },

  // ----------------------------------------------------
  // B2: Quản lý thành viên Admin (Table + Filters + Drawer 7 Tầng)
  // ----------------------------------------------------
  renderB2: function(container) {
    const members = MEDIGO_MOCK_DATA.adminMembers;

    container.innerHTML = `
      <div class="admin-layout">
        <!-- Sidebar cố định rộng 220px -->
        <div class="admin-sidebar">
          <div class="admin-sidebar-brand" onclick="MedigoApp.navigate('A0')" style="cursor: pointer;">
            <svg width="24" height="24" viewBox="0 0 120 120"><circle cx="60" cy="60" r="54" fill="#00ADEE"/><text x="60" y="76" font-family="Arial" font-size="50" font-weight="bold" fill="#FFF" text-anchor="middle">M</text></svg>
            <span>Medigo Admin</span>
          </div>
          <ul class="admin-nav-list">
            <li class="admin-nav-item">
              <a href="javascript:void(0)" class="admin-nav-link active" onclick="MedigoApp.navigate('B2')">
                👥 Thành viên
              </a>
            </li>
            <li class="admin-nav-item">
              <a href="javascript:void(0)" class="admin-nav-link" onclick="MedigoApp.navigate('B3')">
                💸 Yêu cầu rút tiền
              </a>
            </li>
            <li class="admin-nav-item" style="margin-top: 40px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 10px;">
              <a href="javascript:void(0)" class="admin-nav-link" onclick="MedigoApp.navigate('A0')">
                🏠 Về trang sản phẩm
              </a>
            </li>
          </ul>
        </div>

        <!-- Main Content -->
        <div class="admin-main-content">
          <div class="admin-toolbar">
            <h2>Quản lý thành viên (Seller)</h2>
            <div style="display: flex; gap: var(--s4); flex-wrap: wrap;">
              <div class="admin-search-box">
                🔍 <input type="text" class="admin-search-input" placeholder="Tìm tên, SĐT, aff_id...">
              </div>
              <select class="form-control" style="width: 140px;"><option>Tất cả hạng</option><option>Đồng</option><option>Bạc</option><option>Vàng</option></select>
              <select class="form-control" style="width: 160px;"><option>Tất cả trạng thái</option><option>Đang hoạt động</option><option>Đã khóa</option></select>
              <button class="btn btn-secondary" onclick="alert('Đã xuất file CSV!')">Xuất CSV/Excel</button>
            </div>
          </div>

          <!-- Data Table Wrapper -->
          <div class="data-table-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Tên</th>
                  <th>Liên hệ</th>
                  <th>aff_id</th>
                  <th>Tuyến trên</th>
                  <th>Hạng</th>
                  <th>Ngày tham gia</th>
                  <th>Trạng thái</th>
                  <th>Thao tác</th>
                </tr>
              </thead>
              <tbody>
                ${members.map(m => `
                  <tr>
                    <td><strong>${m.fullName}</strong></td>
                    <td>${m.maskedPhone}</td>
                    <td><strong style="color: var(--c6);">${m.aff_id}</strong></td>
                    <td><a href="javascript:void(0)">${m.sponsorAffId}</a></td>
                    <td><span class="rank-badge ${m.rank === 'Vàng' ? 'rank-gold' : (m.rank === 'Bạc' ? 'rank-silver' : 'rank-bronze')}">${m.rank}</span></td>
                    <td>${m.joinDate}</td>
                    <td><span class="badge ${m.status === 'Đang hoạt động' ? 'badge-active' : 'badge-locked'}">${m.status}</span></td>
                    <td>
                      <button class="btn btn-secondary" style="padding: 4px 10px; min-height: 32px; font-size: 13px;" onclick="MedigoViews.openMemberDrawer('${m.aff_id}')">Chi tiết ›</button>
                    </td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Panel Chi tiết Trượt Phải (Drawer Panel) -->
        <div id="admin-member-drawer" class="admin-drawer">
          <div class="drawer-header">
            <h3>Chi tiết hồ sơ thành viên</h3>
            <button class="modal-close" onclick="document.getElementById('admin-member-drawer').classList.remove('open')">✕</button>
          </div>
          <div class="drawer-body" id="drawer-member-content">
            <!-- Dynamic Content -->
          </div>
          <div class="drawer-footer">
            <button class="btn btn-danger btn-full" onclick="alert('Đã khóa tài khoản thành viên!'); document.getElementById('admin-member-drawer').classList.remove('open');">Khóa tài khoản</button>
          </div>
        </div>
      </div>
    `;
  },

  openMemberDrawer: function(affId) {
    const member = MEDIGO_MOCK_DATA.adminMembers.find(m => m.aff_id === affId);
    if (!member) return;

    const content = document.getElementById('drawer-member-content');
    content.innerHTML = `
      <div style="margin-bottom: var(--s6);">
        <h2 style="color: var(--c1);">${member.fullName}</h2>
        <span class="badge badge-active" style="margin-top: 4px;">${member.status}</span>
      </div>

      <div style="background: #F8FAFC; padding: var(--s5); border-radius: var(--r-md); margin-bottom: var(--s6);">
        <h4 style="margin-bottom: 8px;">Thông tin cá nhân (Đầy đủ Admin)</h4>
        <p>📱 SĐT: <strong>${member.phone}</strong></p>
        <p>✉️ Email: <strong>${member.email}</strong></p>
        <p>🪪 Số CCCD: <strong>${member.cccd}</strong></p>
        <p>🏦 Ngân hàng: <strong>${member.bankName} - ${member.bankAccountNo}</strong> (${member.bankAccountOwner})</p>
      </div>

      <div style="margin-bottom: var(--s6);">
        <h4 style="margin-bottom: 8px;">Sơ đồ tuyến dưới 7 tầng (Cây thu gọn)</h4>
        <div style="font-size: 14px; color: var(--c1);">
          <div>🌳 <strong>${member.fullName} (Root)</strong></div>
          <div class="tree-view-node">
            ├── 🌿 Tầng 1: Trần T. B (8 đơn)
            <div class="tree-view-node">
              └── 🍃 Tầng 2: Đỗ V. G (4 đơn)
            </div>
          </div>
          <div class="tree-view-node">
            └── 🌿 Tầng 1: Hoàng V. E (12 đơn)
          </div>
        </div>
      </div>
    `;

    document.getElementById('admin-member-drawer').classList.add('open');
  },

  // ----------------------------------------------------
  // B3: Quản lý Yêu cầu rút tiền Admin
  // ----------------------------------------------------
  renderB3: function(container) {
    const requests = MEDIGO_MOCK_DATA.adminWithdrawals;

    container.innerHTML = `
      <div class="admin-layout">
        <div class="admin-sidebar">
          <div class="admin-sidebar-brand" onclick="MedigoApp.navigate('A0')" style="cursor: pointer;">
            <svg width="24" height="24" viewBox="0 0 120 120"><circle cx="60" cy="60" r="54" fill="#00ADEE"/><text x="60" y="76" font-family="Arial" font-size="50" font-weight="bold" fill="#FFF" text-anchor="middle">M</text></svg>
            <span>Medigo Admin</span>
          </div>
          <ul class="admin-nav-list">
            <li class="admin-nav-item">
              <a href="javascript:void(0)" class="admin-nav-link" onclick="MedigoApp.navigate('B2')">
                👥 Thành viên
              </a>
            </li>
            <li class="admin-nav-item">
              <a href="javascript:void(0)" class="admin-nav-link active" onclick="MedigoApp.navigate('B3')">
                💸 Yêu cầu rút tiền
              </a>
            </li>
            <li class="admin-nav-item" style="margin-top: 40px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 10px;">
              <a href="javascript:void(0)" class="admin-nav-link" onclick="MedigoApp.navigate('A0')">
                🏠 Về trang sản phẩm
              </a>
            </li>
          </ul>
        </div>

        <div class="admin-main-content">
          <div class="admin-toolbar">
            <h2>Yêu cầu rút tiền hoa hồng</h2>
            <div style="display: flex; gap: var(--s4);">
              <select class="form-control" style="width: 160px;"><option>Tất cả trạng thái</option><option>Chờ duyệt</option><option>Đã duyệt</option><option>Đã chi trả</option><option>Từ chối</option></select>
              <button class="btn btn-secondary" onclick="alert('Đã xuất file Excel!')">Xuất Excel</button>
            </div>
          </div>

          <div class="data-table-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Mã YC</th>
                  <th>Seller</th>
                  <th>Số tiền rút</th>
                  <th>Thực nhận</th>
                  <th>Ngày yêu cầu</th>
                  <th>Ngân hàng nhận</th>
                  <th>Trạng thái</th>
                  <th>Thao tác</th>
                </tr>
              </thead>
              <tbody>
                ${requests.map(r => `
                  <tr>
                    <td><strong>${r.id}</strong></td>
                    <td>${r.sellerName} (${r.sellerAffId})</td>
                    <td>${this.formatMoney(r.amount)}</td>
                    <td><strong style="color: var(--c8);">${this.formatMoney(r.netAmount)}</strong></td>
                    <td>${r.requestDate}</td>
                    <td>${r.bankName} - ${r.bankAccountNo}</td>
                    <td>
                      <span class="badge ${r.status === 'Chờ duyệt' ? 'badge-pending' : (r.status === 'Đã duyệt' ? 'badge-approved' : (r.status === 'Đã chi trả' ? 'badge-paid' : 'badge-rejected'))}">${r.status}</span>
                    </td>
                    <td>
                      <button class="btn btn-secondary" style="padding: 4px 10px; min-height: 32px; font-size: 13px;" onclick="MedigoViews.openWithdrawDrawer('${r.id}')">Chi tiết ›</button>
                    </td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Drawer Panel Chi Tiết Duyệt Rút Tiền -->
        <div id="admin-withdraw-drawer" class="admin-drawer">
          <div class="drawer-header">
            <h3>Xử lý yêu cầu rút tiền</h3>
            <button class="modal-close" onclick="document.getElementById('admin-withdraw-drawer').classList.remove('open')">✕</button>
          </div>
          <div class="drawer-body" id="drawer-withdraw-content">
            <!-- Dynamic Content -->
          </div>
        </div>
      </div>
    `;
  },

  openWithdrawDrawer: function(reqId) {
    const r = MEDIGO_MOCK_DATA.adminWithdrawals.find(item => item.id === reqId);
    if (!r) return;

    const content = document.getElementById('drawer-withdraw-content');
    content.innerHTML = `
      <div style="margin-bottom: var(--s6);">
        <h2 style="color: var(--c1);">Yêu cầu ${r.id}</h2>
        <span class="badge ${r.status === 'Chờ duyệt' ? 'badge-pending' : (r.status === 'Đã duyệt' ? 'badge-approved' : (r.status === 'Đã chi trả' ? 'badge-paid' : 'badge-rejected'))}" style="margin-top: 4px;">${r.status}</span>
      </div>

      <div style="background: #F8FAFC; padding: var(--s5); border-radius: var(--r-md); margin-bottom: var(--s6);">
        <h4 style="margin-bottom: 8px;">Chi tiết tài chính</h4>
        <p>Seller: <strong>${r.sellerName}</strong> (aff_id: ${r.sellerAffId})</p>
        <p>Số tiền rút: <strong>${this.formatMoney(r.amount)}</strong></p>
        <p>Thuế TNCN tạm tính (10%): <strong style="color: var(--err);">${this.formatMoney(r.tax)}</strong></p>
        <p style="font-size: 18px; margin-top: 6px;">Thực nhận chuyển khoản: <strong style="color: var(--c8);">${this.formatMoney(r.netAmount)}</strong></p>
      </div>

      <div style="background: #F8FAFC; padding: var(--s5); border-radius: var(--r-md); margin-bottom: var(--s6);">
        <h4 style="margin-bottom: 8px;">Thông tin ngân hàng thụ hưởng</h4>
        <p>Ngân hàng: <strong>${r.bankName}</strong></p>
        <p>Số tài khoản: <strong>${r.bankAccountNo}</strong></p>
        <p>Chủ tài khoản: <strong>${r.bankAccountOwner}</strong></p>
        <p>Chi nhánh: <strong>${r.branch}</strong></p>
      </div>

      ${r.status === 'Chờ duyệt' ? `
        <div class="form-group">
          <label>Lý do từ chối (bắt buộc nếu Từ chối)</label>
          <textarea id="reject-reason" class="form-control" rows="3" placeholder="Nhập lý do từ chối nếu có..."></textarea>
        </div>
        <div style="display: flex; gap: var(--s4); margin-top: var(--s6);">
          <button class="btn btn-danger" style="flex:1;" onclick="if(!document.getElementById('reject-reason').value){alert('Vui lòng nhập lý do từ chối!');}else{alert('Đã từ chối yêu cầu!'); document.getElementById('admin-withdraw-drawer').classList.remove('open');}">Từ chối</button>
          <button class="btn btn-primary" style="flex:1;" onclick="alert('Đã duyệt yêu cầu rút tiền!'); document.getElementById('admin-withdraw-drawer').classList.remove('open'); MedigoApp.navigate('B3');">Duyệt yêu cầu</button>
        </div>
      ` : ''}

      ${r.status === 'Đã duyệt' ? `
        <div style="margin-top: var(--s6);">
          <button class="btn btn-success btn-full" onclick="alert('Đã đánh dấu ĐÃ CHI TRẢ!'); document.getElementById('admin-withdraw-drawer').classList.remove('open'); MedigoApp.navigate('B3');">
            Đánh dấu Đã chi trả
          </button>
        </div>
      ` : ''}
    `;

    document.getElementById('admin-withdraw-drawer').classList.add('open');
  }
};
